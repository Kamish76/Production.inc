# Keystore properties for release signing
# Copy this to key.properties and fill in your values
# DO NOT commit key.properties to version control

storePassword=<your_store_password>
keyPassword=<your_key_password>
keyAlias=<your_key_alias>
storeFile=<path_to_your_keystore_file>

# Example:
# storePassword=myStorePassword
# keyPassword=myKeyPassword
# keyAlias=prodinckey
# storeFile=../keystore/production-inc-keystore.jks
