<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Game data should not be backed up to cloud -->
        <exclude domain="database" />
        <exclude domain="shared_pref" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer for user preferences only -->
        <include domain="shared_pref" path="flutter.shared_preferences.plist"/>
    </device-transfer>
</data-extraction-rules>
