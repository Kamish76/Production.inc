{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flutter: Run Debug",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"--debug"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Flutter: Build APK",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"apk",
				"--release"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Flutter: Run Tests",
			"type": "shell",
			"command": "flutter",
			"args": [
				"test"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Flutter: Clean",
			"type": "shell",
			"command": "flutter",
			"args": [
				"clean"
			],
			"group": "build",
			"problemMatcher": []
		}
	]
}